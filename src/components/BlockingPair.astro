---
import { preferences, phases } from '../lib/blocking-pair';
import '../styles/blocking-pair.css';
const people = [
  { id: 'A', side: 'left', row: 'top', choices: preferences.applicants.A },
  { id: 'B', side: 'left', row: 'bottom', choices: preferences.applicants.B },
  { id: 'X', side: 'right', row: 'top', choices: preferences.mentors.X },
  { id: 'Y', side: 'right', row: 'bottom', choices: preferences.mentors.Y },
];
---
<div class="blocking-demo" data-blocking-demo data-phase="blocking">
  <div class="blocking-top"><p>A blocking pair, in three moments.</p><span>Two applicants / Two mentors</span></div>
  <div class="blocking-layout">
    <figure class="blocking-figure" aria-labelledby="blocking-figure-caption">
      <div class="blocking-scene">
        <div class="blocking-group-label blocking-group-label--left">Applicants</div><div class="blocking-group-label blocking-group-label--right">Mentors</div>
        <svg class="blocking-connections" viewBox="0 0 600 340" preserveAspectRatio="none" fill="none" aria-hidden="true">
          <g class="blocking-current-lines" stroke="#b8accf" stroke-width="1.3" vector-effect="non-scaling-stroke"><path d="M124 98.6H476M124 255H476" /></g>
          <path class="blocking-mutual-line" d="M124 98.6C290 98.6 310 255 476 255" stroke="#00f59b" stroke-width="2" stroke-dasharray="5 6" vector-effect="non-scaling-stroke" />
          <g class="blocking-resolved-lines" stroke-width="1.8" vector-effect="non-scaling-stroke"><path d="M124 98.6C290 98.6 310 255 476 255" stroke="#00f59b" /><path d="M124 255C290 255 310 98.6 476 98.6" stroke="#b8accf" /></g>
        </svg>
        {people.map(person => <div class={`blocking-person blocking-person--${person.side} blocking-person--${person.row}`} data-person={person.id}>
          <div class="blocking-avatar" aria-hidden="true"><svg viewBox="0 0 32 32" width="25" height="25" fill="none"><circle cx="16" cy="10" r="4.5" stroke="currentColor" stroke-width="1.4" /><path d="M7 26v-2a9 9 0 0 1 18 0v2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg></div>
          <strong>{person.id}</strong><span class="blocking-preferences" aria-label={`${person.id} prefers ${person.choices[0]} to ${person.choices[1]}`}>{person.choices.join(' > ')}</span>
        </div>)}
      </div>
      <figcaption id="blocking-figure-caption" data-blocking-caption>{phases[1].caption}</figcaption>
    </figure>
    <div class="blocking-explanation">
      <ol class="blocking-steps">{phases.map(phase => <li><button type="button" data-blocking-phase={phase.id} aria-pressed={phase.id === 'blocking' ? 'true' : 'false'} disabled><span class="blocking-step-number">{phase.number}</span><span class="blocking-step-copy"><strong>{phase.title}</strong><span>{phase.text}</span></span></button></li>)}</ol>
      <p class="blocking-footnote">Preferences read from left to right. This is an illustrative one-to-one matching with strict preferences.</p>
    </div>
  </div>
</div>

<script>
  import '../scripts/blocking-pair';
</script>
