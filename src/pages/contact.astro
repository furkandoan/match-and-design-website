---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { en } from '../data/en';
import { site, mailto } from '../data/site';
---
<Base title={en.contact.title} description={en.contact.description}>
  <section class="page-hero wrap" aria-labelledby="page-title">
    <p class="section-index">{en.contact.title}</p>
    <h1 id="page-title">{en.contact.headline.map(line => <span class="line">{line}</span>)}</h1>
    <p class="lead">{en.contact.intro}</p>
  </section>
  <section class="contact-layout wrap" aria-label="Contact details and enquiry">
    <div>
      <div class="email-block"><p class="section-index">{en.contact.emailLabel}</p><a class="text-link" href={mailto}>{site.contactEmail}<Arrow direction="up-right" /></a></div>
      <div class="contact-prompts"><h2>{en.contact.promptTitle}</h2><ul>{en.contact.prompts.map(prompt => <li>{prompt}</li>)}</ul></div>
    </div>
    <form class="contact-form" id="enquiry-form" data-recipient={site.contactEmail} data-subject={site.contactSubject} hidden>
      <h2>{en.contact.formTitle}</h2><p>{en.contact.formIntro}</p>
      <div class="form-fields">
        <div class="form-field"><label for="enquiry-name">{en.contact.fields.name} <span>(optional)</span></label><input type="text" id="enquiry-name" name="name" autocomplete="name" maxlength="100" /></div>
        <div class="form-field"><label for="enquiry-organisation">{en.contact.fields.organisation} <span>(optional)</span></label><input type="text" id="enquiry-organisation" name="organisation" autocomplete="organization" maxlength="150" /></div>
        <div class="form-field"><label for="enquiry-problem">{en.contact.fields.problem} <span>(required)</span></label><textarea id="enquiry-problem" name="problem" placeholder={en.contact.fields.placeholder} required maxlength="2000" rows="6"></textarea></div>
      </div>
      <button type="submit" class="compose-button">{en.contact.compose}<Arrow direction="up-right" /></button>
      <p class="form-note">{en.contact.formNote}</p>
      <p class="form-status" role="status" hidden></p>
    </form>
    <noscript><p>Please use the email address above to tell us about your allocation problem.</p></noscript>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('#enquiry-form');
  if (form) {
    form.hidden = false;
    form.addEventListener('submit', event => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const values = new FormData(form);
      const name = String(values.get('name') ?? '').trim();
      const organisation = String(values.get('organisation') ?? '').trim();
      const problem = String(values.get('problem') ?? '').trim();
      const problemField = form.elements.namedItem('problem') as HTMLTextAreaElement;
      if (!problem) {
        problemField.setCustomValidity('Please describe the allocation problem.');
        problemField.reportValidity();
        problemField.addEventListener('input', () => problemField.setCustomValidity(''), { once: true });
        return;
      }
      const body = [name ? `Name: ${name}` : '', organisation ? `Organisation: ${organisation}` : '', '', problem].filter((line, index) => line || index === 2).join('\n');
      const recipient = form.dataset.recipient;
      if (!recipient) return;
      const subject = form.dataset.subject ?? 'An allocation problem';
      window.location.href = `mailto:${recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      const status = form.querySelector<HTMLElement>('.form-status');
      if (status) {
        status.hidden = false;
        status.textContent = 'Your email app has been requested. If no draft opens, use the email address on this page. Nothing has been sent.';
      }
    });
  }
</script>
