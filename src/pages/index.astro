---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import AllocationFilm from '../components/AllocationFilm.astro';
import MethodRows from '../components/MethodRows.astro';
import EduscopeFeature from '../components/EduscopeFeature.astro';
import ContactCta from '../components/ContactCta.astro';
import { en } from '../data/en';
---
<Base title={en.home.title} description={en.home.description} home>
  <section class="home-hero" aria-labelledby="hero-title">
    <div class="hero-content wrap">
      <div class="hero-copy">
        <p class="hero-context">Mathematical design. Real-world systems.</p>
        <h1 id="hero-title">{en.home.headline.map(line => <span class="line">{line}</span>)}</h1>
        <p class="lead">{en.home.intro}</p>
        <div class="hero-actions"><a class="button button--light" href="#what-we-design">{en.home.primaryCta}<Arrow /></a><a class="button button--outline" href="/approach/">Our approach<Arrow /></a></div>
      </div>
    </div>
    <AllocationFilm />
    <div class="discipline-rail wrap" aria-label="Our fields"><span>Matching theory</span><span>Market design</span><span>Mechanism design</span><span>Optimization</span></div>
  </section>
  <section class="problem-section section wrap" id="what-we-design" aria-labelledby="problem-title">
    <p class="section-index">What we design</p>
    <h2 id="problem-title">{en.home.problemTitle.map(line => <span class="line">{line}</span>)}</h2>
    <div class="problem-body"><p>{en.home.problemBody}</p><a class="text-link" href="/approach/">{en.home.problemLink}<Arrow /></a></div>
  </section>
  <section class="approach-section section wrap" aria-labelledby="method-title">
    <div class="section-heading"><h2 id="method-title">{en.home.approachTitle}</h2><p>{en.home.approachIntro}</p></div>
    <MethodRows />
  </section>
  <EduscopeFeature />
  <section class="company-section section wrap" aria-labelledby="research-title">
    <h2 id="research-title">{en.home.companyTitle}</h2>
    <div><p>{en.home.companyBody}</p><a class="text-link" href="/market-design/">{en.home.companyLink}<Arrow /></a></div>
  </section>
  <ContactCta />
</Base>
